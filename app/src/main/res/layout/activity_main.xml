<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top Status Bar / Header (Points 9 & 10) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- App Logo + Title -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_nav_dashboard" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Payment Koro"
                        android:textColor="@color/text_main"
                        android:textSize="16sp" />

                    <!-- Live Gateway indicator -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewLiveDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_pill_success" />

                        <TextView
                            android:id="@+id/tvGatewayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Gateway Active (24/7)"
                            android:textColor="@color/success_emerald"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Network Status Chip (Point 9: WiFi or Mobile data) -->
            <LinearLayout
                android:id="@+id/chipNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_network"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/ivNetworkIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Network"
                    android:src="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/tvNetworkType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="WiFi"
                    android:textColor="@color/text_main"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Battery Percent Chip (Point 10: Battery Percent) -->
            <LinearLayout
                android:id="@+id/chipBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_network"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/ivBatteryIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Battery"
                    android:src="@drawable/ic_battery" />

                <TextView
                    android:id="@+id/tvBatteryPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="100%"
                    android:textColor="@color/text_main"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Permission Warning Banner (If SMS Permission is missing) -->
    <LinearLayout
        android:id="@+id/bannerPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF3C7"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="⚠️ SMS পারমিশন প্রয়োজন"
                android:textColor="#92400E"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnHelpRestricted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:padding="4dp"
                android:text="কিভাবে দিবেন?"
                android:textColor="#B45309"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="বিকাশ, নগদ, রকেট ও উপায় এসএমএস অটো রিসিভ করতে পারমিশন দিন।"
            android:textColor="#B45309"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantSmsPermission"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#D97706"
                android:text="পারমিশন সক্রিয় করুন"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAppSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="অ্যাপ সেটিংস খুলুন"
                android:textColor="#92400E"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Frame for Fragments -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerPermission" />

    <!-- 4 Bottom Navigation Buttons -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
